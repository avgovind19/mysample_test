        {
            "name": "Login (POST)",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"password\"\n}"
                },
                "url": {
                    "raw": "http://localhost:3001/login"
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('login responded', function () {",
                            "  pm.response.to.have.status(200);",
                            "});",
                            "if (pm.response.code === 200) {",
                            "  var json = pm.response.json();",
                            "  if (json.user && json.user.username) pm.environment.set('loggedUser', json.user.username);",
                            "}"
                        ]
                    }
                }
            ],
            "response": []
        },
        {
            "name": "Get Current User (/me)",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "http://localhost:3001/me"
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('me status is 200 or 401', function () {",
                            "  pm.expect([200,401]).to.include(pm.response.code);",
                            "});"
                        ]
                    }
                }
            ],
            "response": []
        },
